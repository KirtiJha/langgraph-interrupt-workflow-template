# ─────────────────────────────────────────────────────────────
#  LLM — any provider, any model
# ─────────────────────────────────────────────────────────────
# Leave everything below commented to run on the built-in zero-config mock.
# Then pick ONE of these three options:
#
# ── Option 1: Vercel AI Gateway — one key, models from every provider ──────
#   (recommended on Vercel; model ids are "<provider>/<model>")
# AI_GATEWAY_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-4.6     # or openai/gpt-5, google/gemini-2.5-pro, xai/grok-4 …
#
# ── Option 2: a provider's native API ──────────────────────────────────────
#   OpenAI:     LLM_MODEL=gpt-4o-mini                     + OPENAI_API_KEY
#   Anthropic:  LLM_MODEL=anthropic:claude-sonnet-4-5     + ANTHROPIC_API_KEY
#   Google:     LLM_MODEL=google_genai:gemini-2.5-flash   + GOOGLE_API_KEY
#   (also groq / mistralai / bedrock / ibm / ollama … after installing the
#    matching langchain-<provider> package; "provider:model" or LLM_PROVIDER)
# LLM_MODEL=
# LLM_PROVIDER=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
#
# ── Option 3: ANY OpenAI-compatible endpoint ───────────────────────────────
#   OpenRouter  https://openrouter.ai/api/v1          Groq      https://api.groq.com/openai/v1
#   Together    https://api.together.xyz/v1           DeepSeek  https://api.deepseek.com/v1
#   Ollama      http://localhost:11434/v1 (key: ollama) · vLLM / LM Studio / LiteLLM: your server
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
#   (set LLM_PROVIDER=anthropic for an Anthropic-compatible proxy instead)
#
# Optional:
# LLM_TEMPERATURE=0.7        # omit for reasoning models that only accept their default

# Client-side request cap, smoothing bursts so they don't trip provider rate
# limits (the workflow can fire several calls at once). Recommended on free
# tiers — e.g. 0.5 = one request every 2s. Unset = no limiting.
# LLM_REQUESTS_PER_SECOND=0.5

# IBM watsonx (only if LLM_PROVIDER=ibm)
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=

# Force the offline mock model regardless of the above
# USE_MOCK_LLM=true

# ─────────────────────────────────────────────────────────────
#  Persistence — where paused runs live
# ─────────────────────────────────────────────────────────────
# Postgres: REQUIRED on serverless hosts (Vercel) — consecutive requests can hit
# different instances. Neon from the Vercel Marketplace sets this for you.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DB_POOL_MAX=5
# DB_AUTO_SETUP=true         # create tables on startup (idempotent)
#
# SQLite: durable on a single long-running server.
# CHECKPOINT_DB=checkpoints.db
#
# CORS: on Vercel, set to your frontend URL(s), comma-separated.
# CORS_ORIGINS=https://my-hitl-frontend.vercel.app

# ─────────────────────────────────────────────────────────────
#  Tools (optional)
# ─────────────────────────────────────────────────────────────
# TAVILY_API_KEY=        # enables live web search in tools.py

# ─────────────────────────────────────────────────────────────
#  MCP tools (optional) — Model Context Protocol
# ─────────────────────────────────────────────────────────────
# Load tools from any MCP server and expose them to the agent (HITL-gated).
# Requires: pip install langchain-mcp-adapters
# Set to inline JSON or a path to a JSON file. Examples:
#   MCP_SERVERS='{"math": {"command": "python", "args": ["math_server.py"], "transport": "stdio"}}'
#   MCP_SERVERS=./mcp_servers.json
# MCP_SERVERS=

# ─────────────────────────────────────────────────────────────
#  Guardrails (safety middleware) — on by default, no deps
# ─────────────────────────────────────────────────────────────
# GUARDRAILS_ENABLED=true          # master switch (default: true)
# GUARDRAILS_REDACT_PII=true       # mask emails/phones/cards/SSNs before the model
# GUARDRAILS_BLOCKLIST=            # comma-separated phrases to refuse, e.g. exploit,malware

# ─────────────────────────────────────────────────────────────
#  Structured output (optional) — agent returns a typed summary
# ─────────────────────────────────────────────────────────────
# Requires a real (non-mock) model. The agent returns a validated
# ResearchSummary object in state["structured_response"].
# AGENT_STRUCTURED_OUTPUT=false

# ─────────────────────────────────────────────────────────────
#  Semantic long-term memory (optional)
# ─────────────────────────────────────────────────────────────
# Set an embeddings model to recall the most *relevant* memories (not just the
# most recent). Falls back to plain recency-based recall when unset.
#   EMBEDDINGS_MODEL=openai:text-embedding-3-small
#   EMBEDDING_DIMS=1536

# ─────────────────────────────────────────────────────────────
#  Agent middleware power-pack (prebuilt LangChain middleware)
# ─────────────────────────────────────────────────────────────
# Sensible defaults are on; thresholds are high enough to never trigger in a
# short chat. Set any value to 0/empty to disable that piece.
# AGENT_SUMMARIZATION=true                 # summarize old messages on long threads
# AGENT_SUMMARIZATION_TRIGGER_MESSAGES=40  # summarize once history exceeds this
# AGENT_SUMMARIZATION_KEEP_MESSAGES=20     # keep this many recent messages
# AGENT_MODEL_CALL_LIMIT=25                # cap model calls per run (runaway/cost guard)
# AGENT_TOOL_CALL_LIMIT=                   # cap tool calls per run (opt-in)
# AGENT_MODEL_RETRY=true                   # retry transient model errors (backoff)
# AGENT_MODEL_RETRIES=2
# AGENT_TODO_LIST=false                    # give the agent a write_todos planning tool
# AGENT_FALLBACK_MODEL=                    # fall back to this model on failure, e.g. gpt-4o-mini
# AGENT_TOOL_RESILIENCE=true               # retry transient tool errors; surface failures to the model
# AGENT_TOOL_RETRIES=2
# AGENT_CONTEXT_EDIT_TOKENS=               # clear stale tool outputs past this token budget (opt-in)

# ─────────────────────────────────────────────────────────────
#  Human-in-the-loop approval policy (which tools pause, and when)
# ─────────────────────────────────────────────────────────────
# HITL_INTERRUPT_MODE=per_call   # per_call (one interrupt per tool call, answered by id;
#                                #   langchain>=1.4.6, soon the default) | batched (one per turn)
# HITL_POLICY=all                # all: every acting tool pauses (read-only tools exempt)
#                                # selective: only HITL_ALWAYS tools always pause; others pause
#                                #   only when their arguments match HITL_SENSITIVE_PATTERNS
# HITL_NEVER=ls,read_file,glob,grep,task,write_todos
# HITL_ALWAYS=execute,delete,write_file,edit_file
# HITL_SENSITIVE_PATTERNS=password|secret|api[_ -]?key|ssn|credit card|\bdelete\b|\bdrop\b
# Risk classifier for selective mode: patterns (default, offline) or jev —
# TypeSafe AI's decision model returns a typed verdict with calibrated confidence;
# the gate pauses when risky OR when confidence is below HITL_RISK_CONFIDENCE.
# Needs `pip install langgraph-jev`; falls back to patterns without a key.
# HITL_RISK_CLASSIFIER=jev
# HITL_RISK_CONFIDENCE=0.75
# TYPESAFE_API_KEY=

# ─────────────────────────────────────────────────────────────
#  Workflow resilience (LangGraph 1.2)
# ─────────────────────────────────────────────────────────────
# LLM-backed nodes retry transient errors and degrade gracefully on failure.
# RETRY_MAX_ATTEMPTS=3                      # per-node retry attempts (transient errors)
# NODE_TIMEOUT_SECONDS=                     # per-node wall-clock timeout (empty = off)
# Cap parallel sub-researchers in the Workflow engine. The workflow makes one
# concurrent LLM call per sub-question; on a rate-limited key (e.g. free tier),
# set this to 1-2 to avoid bursting past requests-per-minute limits. Unset = no cap.
# RESEARCH_MAX_SUBQUERIES=2

# ─────────────────────────────────────────────────────────────
#  Persistence & server
# ─────────────────────────────────────────────────────────────
# Set a path to enable durable, resumable state across restarts.
# Leave unset for in-memory state.
# CHECKPOINT_DB=checkpoints.sqlite
PORT=8000
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
#  Observability (optional) — LangSmith tracing
# ─────────────────────────────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langgraph-interrupt-template
